APP_NAME="MWS"
APP_ENV=local
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=svc_db
DB_USER=root
DB_PASS=122190

BASE_URL=http://localhost/Mws/App.php

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRE=86400


# Composer Installation Guide
# Verify: Open Control Panel → System → Advanced system settings → Environment Variables
# Under System variables, select Path → Edit → New
# Add the path to PHP: C:\xampp\php

# Verify php version
# php -v

# Init composer if still no composer.json
# php C:\Users\rocky\composer.phar init

# Open cmd:
# cd C:\xampp\php
# php -r "copy('https://getcomposer.org/composer-stable.phar', 'composer.phar');"
# php composer.phar install       # install packages from composer.json
# php composer.phar require vlucas/phpdotenv   # add a package
# php composer.phar dump-autoload # regenerate autoload files

# PS: if new path added reload the autoloader
# PS C:\xampp\htdocs\Mws\composer> php composer.phar dump-autoload